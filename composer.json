{
    "name": "zembula/module-connect",
    "description": "Connects a Magento Open Source or Adobe Commerce store to Zembula through a Magento integration.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "magento",
        "magento2",
        "adobe-commerce",
        "zembula"
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.4",
        "magento/module-catalog": "^104.0.4",
        "magento/module-configurable-product": "^100.4.4",
        "magento/module-integration": "^100.4.4",
        "magento/module-sales": "^103.0.4"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zembula\\Connect\\": ""
        }
    }
}
